# Stage 1: Build
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# En este proyecto usamos tsx para ejecutar TypeScript directamente.
# El build de producción se resolverá copiando los archivos necesarios y corriendo con tsx o node según corresponda.

# Stage 2: Runtime optimizado y seguro
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Copiar configuraciones y dependencias del builder
COPY package*.json tsconfig.json ./
COPY --from=builder /app/node_modules ./node_modules

# Copiar el backend, la API y los recursos compartidos de src
COPY --from=builder /app/server ./server
COPY --from=builder /app/api ./api
COPY --from=builder /app/src ./src

# Usar usuario no-root por seguridad
USER node

EXPOSE 8787
# Corremos el servidor Express usando el runtime tsx ya instalado
CMD ["npx", "tsx", "server/index.ts"]
