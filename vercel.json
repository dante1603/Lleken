{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ai/care-plan.ts": {
      "maxDuration": 60
    },
    "api/ai/follow-up.ts": {
      "maxDuration": 60
    },
    "api/ai/identify-plant.ts": {
      "maxDuration": 60
    },
    "api/ai/refresh-plant-from-photo.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
